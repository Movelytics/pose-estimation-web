{
  "name": "@pose-tracker/pose-estimation-web",
  "version": "0.1.0",
  "description": "PoseTracker web pose estimation SDK (vanilla) — MoveNet via TensorFlow.js + remote model URL. Exercise engine via API token. No bundled weights.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/pose-tracker.global.js": "./dist/pose-tracker.global.js"
  },
  "unpkg": "./dist/pose-tracker.global.js",
  "jsdelivr": "./dist/pose-tracker.global.js",
  "browser": "./dist/pose-tracker.global.js",
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/pose-tracker.global.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "pose-estimation",
    "movenet",
    "tensorflow.js",
    "human-pose",
    "keypoints",
    "posetracker",
    "webcam",
    "browser",
    "web",
    "sdk"
  ],
  "author": {
    "name": "Movelytics SAS",
    "email": "hello@posetracker.com",
    "url": "https://www.posetracker.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Movelytics/pose-estimation-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movelytics/pose-estimation-web.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "js-sha256": "^0.11.0"
  },
  "peerDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow-models/pose-detection": "^2.1.3"
  },
  "peerDependenciesMeta": {
    "@tensorflow-models/pose-detection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "tsup": "^8.4.0",
    "typescript": "^5.4.0"
  },
  "bugs": {
    "url": "https://github.com/Movelytics/pose-estimation-web/issues"
  }
}
